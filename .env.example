# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"
# Keep the service role key SERVER-SIDE ONLY (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"

# ── Admin dashboard ────────────────────────────────────────────────────────────
# The password you type at /admin to log in.
ADMIN_PASSWORD="choose-a-strong-password"
# A separate random secret used to sign admin session cookies.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET="generate-a-random-64-char-hex-string"

# ── Site ───────────────────────────────────────────────────────────────────────
# Your production URL (used for SEO canonical links, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ── Order notification emails (optional, nodemailer) ──────────────────────────
# Leave blank to disable email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
ORDERS_NOTIFY_EMAIL=""
ORDERS_FROM_EMAIL=""
